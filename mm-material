#!/usr/bin/env python3
"""Export PBR texture sets from Material Maker templates and convert them to the hotspot atlas.

Prints a JSON result on stdout. Errors go to stderr with a non-zero exit code.
"""

import argparse
import json
import random
import shutil
import struct
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
MATERIAL_MAKER = Path("/Applications/Material Maker.app/Contents/MacOS/Material Maker")
CONVERTER = ROOT / "combined_orm_with_grid.ptex"
HOTSPOT_MASK = ROOT / "hotspot_grid_nodes_invert.png"
MAPS = ("albedo", "normal", "orm")
EXPORT_TIMEOUT = 600
# Material Maker 1.7 hardcodes 2048 for command-line exports (src/parse_args.gd ignores --size and the
# Material node size), so smaller sizes are produced by resampling the exported maps with sips.
RENDER_SIZE = 2048
SIZES = (256, 512, 1024, 2048)

# Friendly parameter -> (node name, parameter key or keys, type, (min, max))
TEMPLATES = {
    "metal-scratched": {
        "file": "metal02_hotspot.ptex",
        "description": "Brushed metal with layered scratches and dirt.",
        "params": {
            "scratch_angle": ("scratches", "angle", float, (-180, 180)),
            "scratch_length": ("scratches", "length", float, (0.01, 1)),
            "scratch_layers": ("scratches", "layers", int, (1, 20)),
            "dirt_amount": ("blend2_2", "amount1", float, (0, 1)),
        },
    },
    "metal-noise": {
        "file": "devil_metal.ptex",
        "description": "Noisy, mottled procedural metal.",
        "params": {
            "scale": ("fbm3", ("scale_x", "scale_y"), float, (1, 32)),
            "persistence": ("fbm3", "persistence", float, (0, 1)),
        },
    },
}


class CliError(Exception):
    pass


def check_size(size):
    if size not in SIZES:
        raise CliError(f"size must be one of {', '.join(map(str, SIZES))}, got {size}")


def png_size(path):
    with open(path, "rb") as f:
        header = f.read(24)
    if header[:8] != b"\x89PNG\r\n\x1a\n" or header[12:16] != b"IHDR":
        raise CliError(f"not a PNG file: {path}")
    return struct.unpack(">II", header[16:24])


def find_node(graph, name):
    for node in graph["nodes"]:
        if node["name"] == name:
            return node
    raise CliError(f"node {name!r} not found in graph")


def parse_param(template_name, raw):
    if "=" not in raw:
        raise CliError(f"parameter must be name=value, got {raw!r}")
    name, value = raw.split("=", 1)
    params = TEMPLATES[template_name]["params"]
    if name == "seed":
        try:
            return name, int(value)
        except ValueError:
            raise CliError(f"seed must be an integer, got {value!r}")
    if name not in params:
        allowed = ", ".join(["seed", *params])
        raise CliError(f"unknown parameter {name!r} for {template_name}; allowed: {allowed}")
    _, _, kind, (low, high) = params[name]
    try:
        number = kind(value)
    except ValueError:
        raise CliError(f"{name} must be {kind.__name__}, got {value!r}")
    if not low <= number <= high:
        raise CliError(f"{name} must be between {low} and {high}, got {number}")
    return name, number


def export(ptex, output, size):
    """Run Material Maker on ptex and write its maps to output/{albedo,normal,orm}.png at size."""
    if not MATERIAL_MAKER.exists():
        raise CliError(f"Material Maker not found at {MATERIAL_MAKER}")
    raw_dir = output / "work" / "export"
    if raw_dir.exists():
        shutil.rmtree(raw_dir)
    raw_dir.mkdir(parents=True)
    # --headless crashes on export on macOS.
    cmd = [str(MATERIAL_MAKER), "--export-material", "-o", str(raw_dir), str(ptex)]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=EXPORT_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise CliError(f"Material Maker export timed out after {EXPORT_TIMEOUT}s")

    paths = {}
    for map_name in MAPS:
        produced = raw_dir / f"{ptex.stem}_{map_name}.png"
        if not produced.exists():
            log = (result.stdout + result.stderr).strip()[-2000:]
            raise CliError(f"Material Maker did not produce {produced.name} (exit {result.returncode})\n{log}")
        target = output / f"{map_name}.png"
        if size == RENDER_SIZE:
            shutil.move(produced, target)
        else:
            resize = ["sips", "-z", str(size), str(size), str(produced), "--out", str(target)]
            done = subprocess.run(resize, capture_output=True, text=True)
            if done.returncode != 0:
                raise CliError(f"resizing {produced.name} failed: {done.stderr.strip()}")
        paths[map_name] = target

    sizes = {png_size(p) for p in paths.values()}
    if sizes != {(size, size)}:
        raise CliError(f"expected {size}x{size} maps, got {sizes}")
    width, height = sizes.pop()
    return {"maps": {k: str(v) for k, v in paths.items()}, "width": width, "height": height}


def reseed(graph, seed):
    """Give every unlocked node a seed derived from seed and its name; the graph seed is not inherited."""
    for node in graph["nodes"]:
        if not node.get("seed_locked"):
            node.pop("seed_int", None)
            node["seed"] = random.Random(f"{seed}:{node['name']}").random()


def write_graph(graph, output, name):
    work = output / "work"
    work.mkdir(parents=True, exist_ok=True)
    ptex = work / f"{name}.ptex"
    ptex.write_text(json.dumps(graph, indent=1))
    return ptex


def cmd_list(args):
    return {
        "templates": {
            name: {
                "description": t["description"],
                "parameters": {
                    "seed": {"type": "int"},
                    **{
                        p: {"type": kind.__name__, "min": low, "max": high}
                        for p, (_, _, kind, (low, high)) in t["params"].items()
                    },
                },
            }
            for name, t in TEMPLATES.items()
        },
        "sizes": list(SIZES),
    }


def cmd_generate(args):
    if args.template not in TEMPLATES:
        raise CliError(f"unknown template {args.template!r}; available: {', '.join(TEMPLATES)}")
    template = TEMPLATES[args.template]
    check_size(args.size)
    values = dict(parse_param(args.template, raw) for raw in args.param)

    graph = json.loads((ROOT / template["file"]).read_text())
    for name, value in values.items():
        if name == "seed":
            reseed(graph, value)
            continue
        node_name, keys, _, _ = template["params"][name]
        node = find_node(graph, node_name)
        for key in keys if isinstance(keys, tuple) else (keys,):
            node["parameters"][key] = value

    output = args.output.resolve()
    ptex = write_graph(graph, output, "material")
    result = export(ptex, output, args.size)
    return {"template": args.template, "parameters": values, "ptex": str(ptex), **result}


def cmd_convert_hotspot(args):
    inputs = {"albedo": args.albedo, "normal": args.normal, "orm": args.orm}
    sizes = {}
    for name, path in inputs.items():
        path = path.resolve()
        if not path.is_file():
            raise CliError(f"{name} input not found: {path}")
        inputs[name] = path
        sizes[name] = png_size(path)
    if len(set(sizes.values())) != 1:
        raise CliError(f"input maps must have the same size, got {sizes}")
    width, height = sizes["albedo"]
    if width != height:
        raise CliError(f"input maps must be square, got {width}x{height}")
    check_size(width)

    graph = json.loads(CONVERTER.read_text())
    images = {"image": inputs["albedo"], "image_2": inputs["normal"], "image_3": inputs["orm"], "image_4": HOTSPOT_MASK}
    for node_name, path in images.items():
        find_node(graph, node_name)["parameters"]["image"] = str(path)

    output = args.output.resolve()
    ptex = write_graph(graph, output, "hotspot")
    result = export(ptex, output, width)
    return {"inputs": {k: str(v) for k, v in inputs.items()}, "ptex": str(ptex), **result}


def main():
    parser = argparse.ArgumentParser(prog="mm-material", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("list", help="show templates and their parameters")

    gen = sub.add_parser("generate", help="export a template as albedo, normal, and ORM maps")
    gen.add_argument("template")
    gen.add_argument("--output", type=Path, required=True)
    gen.add_argument("--size", type=int, default=1024)
    gen.add_argument("--param", action="append", default=[], metavar="NAME=VALUE")

    hs = sub.add_parser("convert-hotspot", help="convert a texture set to the hotspot atlas layout")
    hs.add_argument("--albedo", type=Path, required=True)
    hs.add_argument("--normal", type=Path, required=True)
    hs.add_argument("--orm", type=Path, required=True)
    hs.add_argument("--output", type=Path, required=True)

    args = parser.parse_args()
    handler = {"list": cmd_list, "generate": cmd_generate, "convert-hotspot": cmd_convert_hotspot}[args.command]
    try:
        print(json.dumps(handler(args), indent=2))
    except CliError as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
