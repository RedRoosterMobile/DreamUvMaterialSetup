#!/usr/bin/env python3
"""Export PBR texture sets from Material Maker materials and convert them to the hotspot atlas.

Materials are the .ptex graphs in materials/. More can be fetched from materialmaker.org with
`search` and `download`.

Prints a JSON result on stdout. Errors go to stderr with a non-zero exit code.
"""

import argparse
import json
import random
import shutil
import struct
import re
import subprocess
import sys
import urllib.error
import urllib.request
import zlib
from pathlib import Path

ROOT = Path(__file__).resolve().parent
MATERIAL_MAKER = Path("/Applications/Material Maker.app/Contents/MacOS/Material Maker")
MATERIALS = ROOT / "materials"
CONVERTER = ROOT / "hotspot" / "converter.ptex"
HOTSPOT_MASK = ROOT / "hotspot" / "mask.png"
WEBSITE_API = "https://www.materialmaker.org/api"
MAPS = ("albedo", "normal", "orm")
EXPORT_TIMEOUT = 600
# Material Maker 1.7 hardcodes 2048 for command-line exports (src/parse_args.gd ignores --size and the
# Material node size), so smaller sizes are produced by resampling the exported maps with sips.
RENDER_SIZE = 2048
SIZES = (256, 512, 1024, 2048)

# Curated materials/<name>.ptex with friendly parameters. Other materials only accept seed.
# Friendly parameter -> (node name, parameter key or keys, type, (min, max))
TEMPLATES = {
    "metal-scratched": {
        "description": "Brushed metal with layered scratches and dirt.",
        "params": {
            "scratch_angle": ("scratches", "angle", float, (-180, 180)),
            "scratch_length": ("scratches", "length", float, (0.01, 1)),
            "scratch_layers": ("scratches", "layers", int, (1, 20)),
            "dirt_amount": ("blend2_2", "amount1", float, (0, 1)),
        },
    },
    "metal-noise": {
        "description": "Noisy, mottled procedural metal.",
        "params": {
            "scale": ("fbm3", ("scale_x", "scale_y"), float, (1, 32)),
            "persistence": ("fbm3", "persistence", float, (0, 1)),
        },
    },
}

# Edge treatment of the hotspot converter; defaults live in hotspot/converter.ptex.
HOTSPOT_PARAMS = {
    "edge_relief": ("normal_map2", "strength", float, (0, 1)),
    "edge_softness": ("edge_blur", "param1", float, (0.5, 10)),
    "edge_brightness": ("adjust_hsv", "value", float, (0, 1)),
    "edge_roughness": ("math_v3", "d_in2_y", float, (-0.5, 0.5)),
}


class CliError(Exception):
    pass


def check_size(size):
    if size not in SIZES:
        raise CliError(f"size must be one of {', '.join(map(str, SIZES))}, got {size}")


def png_size(path):
    with open(path, "rb") as f:
        header = f.read(24)
    if header[:8] != b"\x89PNG\r\n\x1a\n" or header[12:16] != b"IHDR":
        raise CliError(f"not a PNG file: {path}")
    return struct.unpack(">II", header[16:24])


def find_node(graph, name):
    for node in graph["nodes"]:
        if node["name"] == name:
            return node
    raise CliError(f"node {name!r} not found in graph")


def parse_param(params, raw, owner, seed=True):
    if "=" not in raw:
        raise CliError(f"parameter must be name=value, got {raw!r}")
    name, value = raw.split("=", 1)
    if seed and name == "seed":
        try:
            return name, int(value)
        except ValueError:
            raise CliError(f"seed must be an integer, got {value!r}")
    if name not in params:
        allowed = ", ".join([*(["seed"] if seed else []), *params])
        raise CliError(f"unknown parameter {name!r} for {owner}; allowed: {allowed}")
    _, _, kind, (low, high) = params[name]
    try:
        number = kind(value)
    except ValueError:
        raise CliError(f"{name} must be {kind.__name__}, got {value!r}")
    if not low <= number <= high:
        raise CliError(f"{name} must be between {low} and {high}, got {number}")
    return name, number


def apply_params(graph, params, values):
    for name, value in values.items():
        node_name, keys, _, _ = params[name]
        node = find_node(graph, node_name)
        for key in keys if isinstance(keys, tuple) else (keys,):
            node["parameters"][key] = value


def describe_params(params):
    return {p: {"type": kind.__name__, "min": low, "max": high} for p, (_, _, kind, (low, high)) in params.items()}


def write_flat_png(path, size, rgb):
    """Write a size x size RGB PNG filled with rgb (0-1 floats)."""
    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))

    row = b"\0" + bytes(round(max(0, min(1, c)) * 255) for c in rgb) * size
    ihdr = struct.pack(">IIBBBBB", size, size, 8, 2, 0, 0, 0)
    path.write_bytes(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + chunk(b"IDAT", zlib.compress(row * size)) + chunk(b"IEND", b""))


def constant_orm(graph):
    """(AO, roughness, metallic) when none of them is connected to the Material node, else None.

    Material Maker skips the ORM map in that case, so it has to be written from the node's constants.
    """
    if any(c["to"] == "Material" and c["to_port"] in (1, 2, 5) for c in graph["connections"]):
        return None
    params = find_node(graph, "Material")["parameters"]
    return tuple(float(params.get(key, 1)) for key in ("ao", "roughness", "metallic"))


def export(ptex, output, size, flat_orm=None):
    """Run Material Maker on ptex and write its maps to output/{albedo,normal,orm}.png at size.

    flat_orm, if given, is the (AO, roughness, metallic) color of an ORM map Material Maker does not export.
    """
    if not MATERIAL_MAKER.exists():
        raise CliError(f"Material Maker not found at {MATERIAL_MAKER}")
    raw_dir = output / "work" / "export"
    if raw_dir.exists():
        shutil.rmtree(raw_dir)
    raw_dir.mkdir(parents=True)
    # --headless crashes on export on macOS.
    cmd = [str(MATERIAL_MAKER), "--export-material", "-o", str(raw_dir), str(ptex)]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=EXPORT_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise CliError(f"Material Maker export timed out after {EXPORT_TIMEOUT}s")

    paths = {}
    for map_name in MAPS:
        produced = raw_dir / f"{ptex.stem}_{map_name}.png"
        if not produced.exists() and not (map_name == "orm" and flat_orm):
            log = (result.stdout + result.stderr).strip()[-2000:]
            raise CliError(f"Material Maker did not produce {produced.name} (exit {result.returncode})\n{log}")
        target = output / f"{map_name}.png"
        if map_name == "orm" and flat_orm:
            write_flat_png(target, size, flat_orm)
        elif size == RENDER_SIZE:
            shutil.move(produced, target)
        else:
            resize = ["sips", "-z", str(size), str(size), str(produced), "--out", str(target)]
            done = subprocess.run(resize, capture_output=True, text=True)
            if done.returncode != 0:
                raise CliError(f"resizing {produced.name} failed: {done.stderr.strip()}")
        paths[map_name] = target

    sizes = {png_size(p) for p in paths.values()}
    if sizes != {(size, size)}:
        raise CliError(f"expected {size}x{size} maps, got {sizes}")
    width, height = sizes.pop()
    return {"maps": {k: str(v) for k, v in paths.items()}, "width": width, "height": height}


def reseed(graph, seed):
    """Give every unlocked node a seed derived from seed and its name; the graph seed is not inherited."""
    for node in graph["nodes"]:
        if not node.get("seed_locked"):
            node.pop("seed_int", None)
            node["seed"] = random.Random(f"{seed}:{node['name']}").random()


def write_graph(graph, output, name):
    work = output / "work"
    work.mkdir(parents=True, exist_ok=True)
    ptex = work / f"{name}.ptex"
    ptex.write_text(json.dumps(graph, indent=1))
    return ptex


def load_materials():
    """Name -> material info for every materials/*.ptex; downloads carry a .json sidecar with their source."""
    found = {}
    for ptex in sorted(MATERIALS.glob("*.ptex")):
        name = ptex.stem
        info = {"path": ptex, "description": "", "params": {}}
        if name in TEMPLATES:
            info.update(TEMPLATES[name])
        meta = ptex.with_suffix(".json")
        if meta.exists():
            info["source"] = json.loads(meta.read_text())
            info["description"] = info["description"] or info["source"]["description"]
        found[name] = info
    return found


def fetch_json(url):
    try:
        with urllib.request.urlopen(url, timeout=60) as response:
            return json.load(response)
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as e:
        raise CliError(f"request to {url} failed: {e}")


def website_materials():
    """Static PBR materials on materialmaker.org; other types are brushes, environments, and animated materials."""
    return [m for m in fetch_json(f"{WEBSITE_API}/getMaterials") if m["type"] == 0]


def slugify(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def cmd_list(args):
    return {
        "materials": {
            name: {
                "description": m["description"],
                "parameters": {"seed": {"type": "int"}, **describe_params(m["params"])},
                **({"source": m["source"]} if "source" in m else {}),
            }
            for name, m in load_materials().items()
        },
        "convert_hotspot_parameters": describe_params(HOTSPOT_PARAMS),
        "sizes": list(SIZES),
    }


def cmd_search(args):
    words = [w.lower() for w in args.query]
    downloaded = {m["source"]["id"]: name for name, m in load_materials().items() if "source" in m}
    results = []
    for m in website_materials():
        text = " ".join((m["name"], m["tags"], m["description"], m["author"])).lower()
        if all(w in text for w in words) and (not args.license or m["license"] == args.license):
            results.append({
                "id": m["id"],
                "name": m["name"],
                "author": m["author"],
                "license": m["license"],
                "tags": m["tags"],
                "description": m["description"],
                **({"downloaded_as": downloaded[m["id"]]} if m["id"] in downloaded else {}),
            })
    return {"count": len(results), "materials": results[: args.limit]}


def cmd_download(args):
    listing = {m["id"]: m for m in website_materials()}
    if args.id not in listing:
        raise CliError(f"no material with id {args.id} on materialmaker.org; use `search` to find ids")
    info = listing[args.id]
    name = args.name or slugify(info["name"]) or f"material-{args.id}"
    if slugify(name) != name:
        raise CliError(f"name must be lowercase letters, digits, and dashes, got {name!r}")
    ptex = MATERIALS / f"{name}.ptex"
    meta = ptex.with_suffix(".json")
    if name in TEMPLATES or (ptex.exists() and not meta.exists()):
        raise CliError(f"{name!r} is a curated material; pass --name to save under another name")
    if ptex.exists() and json.loads(meta.read_text())["id"] != args.id and not args.force:
        raise CliError(f"{name!r} already holds another download; pass --name or --force")

    graph = json.loads(fetch_json(f"{WEBSITE_API}/getMaterial?id={args.id}")["json"])
    node = next((n for n in graph["nodes"] if n["name"] == "Material"), None)
    if node is None:
        raise CliError(f"material {args.id} has no Material node")
    if node["type"] == "material_unlit":
        raise CliError(f"material {args.id} is unlit and has no albedo, normal, or ORM maps to export")

    source = {
        "id": args.id,
        "name": info["name"],
        "author": info["author"],
        "license": info["license"],
        "description": info["description"],
        "tags": info["tags"],
        "url": f"https://www.materialmaker.org/material?id={args.id}",
    }
    ptex.write_text(json.dumps(graph, indent=1))
    meta.write_text(json.dumps(source, indent=2) + "\n")
    return {"material": name, "ptex": str(ptex), "material_node": node["type"], "source": source}


def convert_hotspot(inputs, output, raw_params):
    """Convert albedo, normal, and ORM PNGs to the hotspot atlas layout in output."""
    sizes = {}
    for name, path in inputs.items():
        path = path.resolve()
        if not path.is_file():
            raise CliError(f"{name} input not found: {path}")
        inputs[name] = path
        sizes[name] = png_size(path)
    if len(set(sizes.values())) != 1:
        raise CliError(f"input maps must have the same size, got {sizes}")
    width, height = sizes["albedo"]
    if width != height:
        raise CliError(f"input maps must be square, got {width}x{height}")
    check_size(width)

    values = dict(parse_param(HOTSPOT_PARAMS, raw, "convert-hotspot", seed=False) for raw in raw_params)

    graph = json.loads(CONVERTER.read_text())
    apply_params(graph, HOTSPOT_PARAMS, values)
    images = {"image": inputs["albedo"], "image_2": inputs["normal"], "image_3": inputs["orm"], "image_4": HOTSPOT_MASK}
    for node_name, path in images.items():
        find_node(graph, node_name)["parameters"]["image"] = str(path)

    ptex = write_graph(graph, output, "hotspot")
    result = export(ptex, output, width)
    return {"inputs": {k: str(v) for k, v in inputs.items()}, "parameters": values, "ptex": str(ptex), **result}


def cmd_generate(args):
    available = load_materials()
    if args.template not in available:
        raise CliError(f"unknown material {args.template!r}; available: {', '.join(available)}")
    template = available[args.template]
    check_size(args.size)
    values = dict(parse_param(template["params"], raw, args.template) for raw in args.param)
    hotspot = args.hotspot or bool(args.hotspot_param)
    if hotspot:
        # Validate before the slow material export.
        for raw in args.hotspot_param:
            parse_param(HOTSPOT_PARAMS, raw, "convert-hotspot", seed=False)

    graph = json.loads(template["path"].read_text())
    if "seed" in values:
        reseed(graph, values["seed"])
    apply_params(graph, template["params"], {k: v for k, v in values.items() if k != "seed"})

    output = args.output.resolve()
    ptex = write_graph(graph, output, "material")
    result = export(ptex, output, args.size, constant_orm(graph))
    if hotspot:
        maps = {k: Path(v) for k, v in result["maps"].items()}
        result["hotspot"] = convert_hotspot(maps, output / "hotspot", args.hotspot_param)
    return {"material": args.template, "parameters": values, "ptex": str(ptex), **result}


def cmd_convert_hotspot(args):
    inputs = {"albedo": args.albedo, "normal": args.normal, "orm": args.orm}
    return convert_hotspot(inputs, args.output.resolve(), args.param)


def main():
    parser = argparse.ArgumentParser(prog="mm-material", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("list", help="show local materials and their parameters")

    search = sub.add_parser("search", help="search materials on materialmaker.org")
    search.add_argument("query", nargs="*", help="words that must all appear in name, tags, description, or author")
    search.add_argument("--license", choices=("CC0", "CC-BY", "CC-BY-SA"))
    search.add_argument("--limit", type=int, default=20)

    dl = sub.add_parser("download", help="download a materialmaker.org material into materials/")
    dl.add_argument("id", type=int)
    dl.add_argument("--name", help="local material name (default: derived from the website name)")
    dl.add_argument("--force", action="store_true", help="replace a different download with the same name")

    gen = sub.add_parser("generate", help="export a material as albedo, normal, and ORM maps")
    gen.add_argument("template", metavar="material")
    gen.add_argument("--output", type=Path, required=True)
    gen.add_argument("--size", type=int, default=1024)
    gen.add_argument("--param", action="append", default=[], metavar="NAME=VALUE")
    gen.add_argument("--hotspot", action="store_true", help="also convert the maps to the hotspot atlas in OUTPUT/hotspot")
    gen.add_argument("--hotspot-param", action="append", default=[], metavar="NAME=VALUE",
                     help="convert-hotspot parameter; implies --hotspot")

    hs = sub.add_parser("convert-hotspot", help="convert a texture set to the hotspot atlas layout")
    hs.add_argument("--albedo", type=Path, required=True)
    hs.add_argument("--normal", type=Path, required=True)
    hs.add_argument("--orm", type=Path, required=True)
    hs.add_argument("--output", type=Path, required=True)
    hs.add_argument("--param", action="append", default=[], metavar="NAME=VALUE")

    args = parser.parse_args()
    handler = {
        "list": cmd_list,
        "search": cmd_search,
        "download": cmd_download,
        "generate": cmd_generate,
        "convert-hotspot": cmd_convert_hotspot,
    }[args.command]
    try:
        print(json.dumps(handler(args), indent=2))
    except CliError as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
